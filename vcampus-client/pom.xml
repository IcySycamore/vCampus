<?xml version="1.0" encoding="UTF-8"?>
<project 
    xmlns="http://maven.apache.org/POM/4.0.0"
         
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>edu.seu.vcampus</groupId>
        <artifactId>vcampus</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>vcampus-client</artifactId>
    <name>vCampus Client</name>
    <description>GUI 客户端（Swing），依赖 vcampus-common。打包产物 vCampusClient.jar。</description>
    <repositories>
        <!-- 图标资源 JAR 位于 resources 中的项目级 Maven 仓库。 -->
        <repository>
            <id>vcampus-icon-resources</id>
            <url>file://${project.basedir}/src/main/resources/repository</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>edu.seu.vcampus</groupId>
            <artifactId>vcampus-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 仓库不提交散装 PNG；图标及其许可证统一封装在本地资源 JAR 中。 -->
        <dependency>
            <groupId>edu.seu.vcampus</groupId>
            <artifactId>vcampus-icons</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>vCampusClient</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- 本地 Maven 仓库不作为普通资源复制，避免 JAR 内嵌 JAR。 -->
                <excludes>
                    <exclude>repository/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>edu.seu.vcampus.client.VCampusClientApp</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
